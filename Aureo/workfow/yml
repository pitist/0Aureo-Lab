name: 0Aureo — Lean Truth Pipeline

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: 0aureo-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lean:
    name: Lean + Mathlib VERIFICATION
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Lean
        uses: leanprover/lean-action@v1

      - name: Cache Mathlib
        uses: actions/cache@v4
        with:
          path: |
            .lake/packages
            .lake/build
          key: ${{ runner.os }}-mathlib-${{ hashFiles('lakefile.lean', 'lake-manifest.json') }}
          restore-keys: |
            ${{ runner.os }}-mathlib-

      - name: Fetch dependencies
        run: lake update

      - name: Build
        run: lake build

      - name: Kernel verification
        run: lake env lean Aureo/PipelineTest.lean

      - name: Generate report
        run: |
          mkdir -p results
          echo "0Aureo Lean Verification" > results/verification.txt
          echo "STATUS: VERIFIED" >> results/verification.txt
          lake env lean --version >> results/verification.txt
          lake --version >> results/verification.txt

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: 0aureo-verification
          path: results/verification.txt

  integrity:
    name: Repository Integrity
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check structure
        run: |
          test -f README.md
          test -f lakefile.lean
          test -f Aureo/PipelineTest.lean
          echo "STRUCTURE: VERIFIED"