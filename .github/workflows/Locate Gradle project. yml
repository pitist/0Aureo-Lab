- name: Locate Gradle project
        shell: bash
        run: |
          set -e

          GRADLEW=$(find . -type f -name gradlew -not -path './.git/*' | head -n 1)

          if [ -z "$GRADLEW" ]; then
            echo "::error::No se encontró gradlew en el repositorio"
            echo "Estructura encontrada:"
            find . -maxdepth 3 -type f | sort | head -200
            exit 1
          fi

          echo "Gradle Wrapper encontrado: $GRADLEW"

          GRADLE_DIR=$(dirname "$GRADLEW")

          echo "GRADLE_DIR=$GRADLE_DIR" >> "$GITHUB_ENV"

          chmod +x "$GRADLEW"

      - name: Build release
        shell: bash
        run: |
          set -e
          cd "$GRADLE_DIR"
          ./gradlew assembleRelease --no-daemon